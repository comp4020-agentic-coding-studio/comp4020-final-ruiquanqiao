{
  "name": "comp4020-final",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "build": "esbuild client/main.ts --bundle --minify --format=esm --target=es2022 --sourcemap --outfile=dist/app.js",
    "start": "node server/main.ts",
    "dev": "pnpm build && node server/main.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "check:evidence": "node scripts/check-evidence.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "dependencies": {
    "marked": "^18.0.14",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  }
}
